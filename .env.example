# Bu dosyayi .env olarak kopyala ve degerleri kendine gore doldur.
# .env asla git'e girmez (.gitignore'da).
POSTGRES_USER=credit
POSTGRES_PASSWORD=degistir_beni
POSTGRES_DB=credit_risk
# 5432 bu makinede baska bir proje tarafindan kullaniliyor, bu yuzden 5433
POSTGRES_PORT=5433
# 'localhost' DEGIL, '127.0.0.1'.
# Windows'ta localhost once ::1 (IPv6) olarak cozumlenir ve Docker Desktop'in
# IPv6 port yonlendirmesi kararsiz calisabiliyor: baglanti kabul edilip hemen
# dusuruluyor ("Software caused connection abort"). 127.0.0.1 IPv4'u zorlar.
POSTGRES_HOST=127.0.0.1
