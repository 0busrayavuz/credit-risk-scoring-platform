# Sirlar
.env

# Ham ve islenmis veri (2,5 GB - GitHub'a veri yuklenmez).
# Klasorlerin ICERIGI dislanir ama .gitkeep dosyalarina izin verilir;
# boylece repoyu klonlayan kisi hazir klasor yapisini bulur.
data/raw/*
data/processed/*
data/interim/*
!data/*/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# MLflow deney deposu ve model ciktilari.
# MLflow 3.x dosya tabanli mlruns/ deposunu kullanimdan kaldirdi; bu proje
# SQLite arka ucu kullaniyor (mlflow.db) ve artefaktlar mlartifacts/ altinda.
# Ekipte ortak bir MLflow sunucusu kullanilir, bu dosyalar yerelde kalir.
mlruns/
mlflow.db
mlartifacts/

# Tek kullanimlik analiz modeli: yalnizca "adil karsilastirma" sorusunu
# cevaplamak icin egitildi, servise konmuyor, baska yerde kullanilmiyor.
# 2,7 MB'lik bu dosyayi versiyon kontrolunde tasimanin anlami yok;
# src/model_dogrulama.py calistirilinca yeniden uretilir.
models/xgboost_esit_karsilastirma.json

# NOT: models/ altindaki DIGER egitilmis modeller BILINCLI olarak repoda
# tutuluyor (~7 MB). Boylece repoyu klonlayan biri 5 dakikalik egitim
# beklemeden API'yi ve kar analizini calistirabilir - portfolyo projesinde
# bu onemli.
# Gercek uretim ortaminda modeller git'te degil, bir model kayit sisteminde
# (MLflow Model Registry) tutulur ve git yalnizca kodu barindirir.

# IDE / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
