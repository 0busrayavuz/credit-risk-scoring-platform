# Sirlar
.env

# Ham ve islenmis veri (2,5 GB - GitHub'a veri yuklenmez).
# Klasorlerin ICERIGI dislanir ama .gitkeep dosyalarina izin verilir;
# boylece repoyu klonlayan kisi hazir klasor yapisini bulur.
data/raw/*
data/processed/*
data/interim/*
!data/*/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# MLflow / model ciktilari
mlruns/
mlartifacts/
models/*.pkl
models/*.joblib

# IDE / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
